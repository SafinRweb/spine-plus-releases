<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later show their own screen while the app starts. By default it puts
         the launcher icon in a circle on a white page; here it is the logo alone on ink. -->
    <style name="Theme.Spine" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>
</resources>
